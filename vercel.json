{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "buildCommand": "mkdir -p dataset/geo && { cp ../../dataset/geo/provinsi-38.min.geojson dataset/geo/ 2>/dev/null || true; } && test -f dataset/geo/provinsi-38.min.geojson",
      "functions": {
        "app/main.py": {
          "maxDuration": 60
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
