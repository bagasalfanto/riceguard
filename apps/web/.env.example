# Base URL FastAPI. Kosong = /api/v1 (same-origin; `vite dev` mem-proxy /api ke 127.0.0.1:8000).
VITE_API_BASE_URL=

# `true` = halaman peta membaca /provinces + /map/layers dari API.
# `false`/kosong = membaca snapshot statis public/data/*.json (mode demo tanpa backend).
VITE_USE_API_MAP=false

# Konfigurasi Supabase Auth untuk panel admin (/admin/*).
# Opsional untuk halaman publik; isi keduanya agar login admin aktif.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
