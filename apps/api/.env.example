# --- Backend (apps/api) ---
# Postgres Supabase, session pooler. Isi manual.
DATABASE_URL=

# Project URL, dipakai untuk verifikasi JWT (issuer + JWKS).
SUPABASE_URL=https://dxgqjmcxraqammhzoufw.supabase.co

# Service role / secret key. HANYA di server, jangan pernah masuk bundle FE.
SUPABASE_SERVICE_ROLE_KEY=

# Isi hanya kalau project masih memakai JWT secret legacy (HS256).
SUPABASE_JWT_SECRET=

# Domain FE yang boleh memanggil API, dipisah koma. 4173 = `vite preview`.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Batas ukuran per file upload (MB).
MAX_UPLOAD_MB=2
