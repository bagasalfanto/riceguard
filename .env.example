# Salinan nilai-nilai ini ke `.env` di folder yang sesuai. Jangan commit `.env`.
#
# apps/api/.env
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password-terenkode>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# MAX_UPLOAD_MB=2
# AI_ENDPOINT_URL=
# AI_API_TOKEN=
# AI_TIMEOUT_DETIK=20
#
# apps/web/.env
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_USE_API_MAP=true
