{
  "name": "riceguard",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "build:web": "npm run build --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "api:types": "npm run api:types --workspace apps/web",
    "test:calc": "python -m pytest packages/riceguard_calc/tests dataset/tests -q",
    "test:api": "python -m pytest apps/api/tests -q",
    "test": "npm run test:calc && npm run test:api"
  }
}
