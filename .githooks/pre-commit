#!/usr/bin/env bash
#
# Pre-commit hook RiceGuard.
#
# Memvalidasi tautan dan rujukan dokumen, serta drift kode-vs-dokumen untuk
# perubahan yang sudah di-stage. Lewati hanya bila benar-benar sadar:
#   git commit --no-verify
#
# Aktifkan sekali per klon:
#   git config core.hooksPath .githooks

set -euo pipefail

PYTHON_BIN=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo "pre-commit: python tidak ditemukan di PATH; pemeriksaan dokumen dilewati." >&2
    exit 0
fi

if [ ! -f scripts/docs-guard.py ]; then
    echo "pre-commit: scripts/docs-guard.py tidak ada; pemeriksaan dokumen dilewati." >&2
    exit 0
fi

if "$PYTHON_BIN" scripts/docs-guard.py --staged; then
    exit 0
fi

cat >&2 <<'PESAN'

Commit ditolak: ada temuan pada dokumen.

Yang diperiksa:
  - tautan rusak, absolut, atau berawalan file://
  - berkas docs tidak terdaftar di docs/INDEX.md (orphan) atau sebaliknya (ghost)
  - berkas docs kehilangan frontmatter / H1 / batas baris
  - kode berubah tanpa dokumen pendamping (lihat docs-map.json)

Perbaiki temuan di atas pada siklus ini, lalu ulangi commit.
Peta kode-ke-dokumen dan aturannya: AGENTS.md bagian 0.3.
PESAN

exit 1
